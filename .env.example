# Copy to .env. Generate your own local password; do not commit .env.
POSTGRES_USER=parkinsense
POSTGRES_DB=parkinsense
POSTGRES_PASSWORD=replace-with-generated-password
POSTGRES_PORT=55432
PARKINSENSE_DATABASE_URL=postgresql+psycopg://parkinsense:replace-with-generated-password@127.0.0.1:55432/parkinsense
PARKINSENSE_STORAGE_ROOT=data/private
# PostgreSQL is required for normal operation. SQLite is only an explicit test/development option.
PARKINSENSE_ALLOW_SQLITE=0
# Optional private deployment ICE configuration (JSON); localhost needs no external STUN server.
PARKINSENSE_ICE_SERVERS=[]
# Private media gateway; phones/remote clients need a configured HTTPS origin.
PARKINSENSE_MEDIA_BASE_URL=http://127.0.0.1:8503
